datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
}

model ScanLog {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  userId             String
  senderDomain       String?
  subjectLength      Int
  bodyLength         Int
  linkCount          Int
  scanType           String
  timestamp          DateTime
  duration           Int
  isPhishing         Boolean
  phishingConfidence Float
  riskLevel          String
  isAI               Boolean
  aiConfidence       Float
  aiProbability      String
  extensionVersion   String
  browser            String
  extTimestamp       DateTime
  createdAt          DateTime @default(now())
}
